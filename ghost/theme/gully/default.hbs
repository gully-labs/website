<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{meta_title}}</title>
    <meta name="theme-color" content="#0d141c">

    {{!-- The brand kit icon set, served by the main site (cut from the kit master by scripts/brand-from-kit.mjs, never
          upscaled). After {{ghost_head}}, so these win over the icon Ghost prints from its own settings. No web app
          manifest: gullylabs.xyz/manifest.json is for the main site (start_url "/" there) and a cross-origin manifest
          is fetched with CORS, which that host does not send. --}}

    {{!-- Brand fonts, self-hosted in the theme. Declared here (not in the stylesheet) so the preload
          URLs and the @font-face URLs are the same cache-busted {{asset}} URLs: one download each. --}}
    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/hanken-grotesk-latin-400-normal.woff2"}}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/barlow-condensed-latin-800-normal.woff2"}}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/ibm-plex-mono-latin-400-normal.woff2"}}" crossorigin>
    {{> "fonts"}}

    <link rel="stylesheet" href="{{asset "css/screen.css"}}">

    {{!-- Per-post share image, rendered by the main site from the post's own banner (server/og.mjs):
          a still frame of the same seeded art, the title, the primary tag and the wordmark. Only for
          posts without a feature image (and without their own social image): a feature image is the
          author's real content and stays the share image. Before {{ghost_head}} because crawlers take
          the first og:image / twitter:image. See ghost/README.md, "Share images". --}}
    {{#is "post"}}
        {{#post}}
            {{#unless feature_image}}
                {{#unless og_image}}
                    <meta property="og:image" content="https://gullylabs.xyz/og/blog/{{slug}}.png">
                    <meta property="og:image:width" content="1200">
                    <meta property="og:image:height" content="630">
                    <meta property="og:image:alt" content="{{title}}">
                {{/unless}}
                {{#unless twitter_image}}
                    <meta name="twitter:image" content="https://gullylabs.xyz/og/blog/{{slug}}.png">
                    <meta name="twitter:image:alt" content="{{title}}">
                {{/unless}}
            {{/unless}}
        {{/post}}
    {{/is}}

    <script defer src="https://analytics.gullylabs.xyz/script.js" data-website-id="78f29233-9f70-4c45-a440-35d1457d2207" data-domains="blog.gullylabs.xyz" data-web3="true"></script>
    {{ghost_head}}
    <link rel="icon" href="https://gullylabs.xyz/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" type="image/png" sizes="32x32" href="https://gullylabs.xyz/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="https://gullylabs.xyz/favicon-16.png">
    <link rel="icon" type="image/png" sizes="512x512" href="https://gullylabs.xyz/icon-512.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://gullylabs.xyz/apple-touch-icon.png">
</head>
<body class="{{body_class}}{{#if @custom.animated_banners}} gl-animate{{/if}}">

<a class="gl-skip" href="#gl-main">Skip to content</a>

<div class="gl-viewport">
    {{> "header"}}

    {{{body}}}

    {{> "footer"}}
</div>

{{> "mobile-sheet"}}

<div class="gl-toast" role="status" aria-live="polite"></div>

<script src="{{asset "js/lib/reframe.min.js"}}" defer></script>
<script src="{{asset "js/banner.js"}}" defer></script>
<script src="{{asset "js/gully.js"}}" defer></script>

{{ghost_foot}}
</body>
</html>
