<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{meta_title}}</title>
    <meta name="theme-color" content="#06050D">

    {{!-- Brand fonts, self-hosted in the theme. Declared here (not in the stylesheet) so the preload
          URLs and the @font-face URLs are the same cache-busted {{asset}} URLs: one download each. --}}
    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/poppins-latin-500-normal.woff2"}}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/poppins-latin-700-normal.woff2"}}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/ibm-plex-mono-latin-400-normal.woff2"}}" crossorigin>
    {{> "fonts"}}

    <link rel="stylesheet" href="{{asset "css/screen.css"}}">

    {{!-- Share image (owner rule: every brand uses its own kit OG image). Every page that has no image of its own
          gets the Gully Labs kit's og-image-1200x630.png at an absolute blog.gullylabs.xyz URL, before {{ghost_head}}
          because crawlers take the first og:image / twitter:image. A post's feature image (or its own social image)
          is the author's real content and stays its share image: Ghost prints those. Theme setting "Generated post
          share images" (off by default): posts without an image use the main site's generated still
          (https://gullylabs.xyz/og/blog/<slug>.png, server/og.mjs) instead of the kit image. --}}
    {{#is "post, page"}}
        {{#post}}
            {{#unless feature_image}}
                {{#unless og_image}}
                    {{#if @custom.generated_post_share_images}}
                    <meta property="og:image" content="https://gullylabs.xyz/og/blog/{{slug}}.png">
                    <meta property="og:image:alt" content="{{title}}">
                    {{else}}
                    <meta property="og:image" content="{{@site.url}}{{asset "brand/social/og-image-1200x630.png"}}">
                    <meta property="og:image:alt" content="Gully Labs logo with mascot">
                    {{/if}}
                    <meta property="og:image:width" content="1200">
                    <meta property="og:image:height" content="630">
                {{/unless}}
                {{#unless twitter_image}}
                    <meta name="twitter:card" content="summary_large_image">
                    {{#if @custom.generated_post_share_images}}
                    <meta name="twitter:image" content="https://gullylabs.xyz/og/blog/{{slug}}.png">
                    <meta name="twitter:image:alt" content="{{title}}">
                    {{else}}
                    <meta name="twitter:image" content="{{@site.url}}{{asset "brand/social/og-image-1200x630.png"}}">
                    <meta name="twitter:image:alt" content="Gully Labs logo with mascot">
                    {{/if}}
                {{/unless}}
            {{/unless}}
        {{/post}}
    {{else}}
        <meta property="og:site_name" content="Gully Labs">
        <meta property="og:image" content="{{@site.url}}{{asset "brand/social/og-image-1200x630.png"}}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="Gully Labs logo with mascot">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:image" content="{{@site.url}}{{asset "brand/social/og-image-1200x630.png"}}">
        <meta name="twitter:image:alt" content="Gully Labs logo with mascot">
    {{/is}}

    <script defer src="https://analytics.gullylabs.xyz/script.js" data-website-id="78f29233-9f70-4c45-a440-35d1457d2207" data-domains="blog.gullylabs.xyz" data-web3="true"></script>
    {{ghost_head}}
    {{> "brand/head"}}
</head>
<body class="{{body_class}}{{#if @custom.animated_banners}} gl-animate{{/if}}">

<a class="gl-skip" href="#gl-main">Skip to content</a>

<div class="gl-viewport">
    {{> "header"}}
    {{> "ticker"}}

    {{{body}}}

    {{> "footer"}}
</div>

{{> "mobile-sheet"}}

{{!-- Toasts stack here (bottom right), one per real event: link copied, code copied, copy failed. assets/js/gully.js --}}
<div class="gl-toasts" role="status" aria-live="polite" data-gl-toasts></div>

<script src="{{asset "js/lib/reframe.min.js"}}" defer></script>
<script src="{{asset "js/banner.js"}}" defer></script>
<script src="{{asset "js/gully.js"}}" defer></script>

{{ghost_foot}}
</body>
</html>
