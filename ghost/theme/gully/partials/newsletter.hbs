{{!-- Newsletter sign-up (Ghost members forms). Callers render it only inside {{#if @site.members_enabled}}.
      variant: footer | post --}}
<section class="gl-newsletter gl-newsletter--{{variant}}" aria-labelledby="gl-nl-{{variant}}">
    <div class="gl-newsletter-inner{{#match variant "footer"}} gl-page{{/match}}">
        <div class="gl-newsletter-copy">
            <p class="gl-kicker">{{> "icons/mail"}}<span>Newsletter</span></p>
            <h2 class="gl-newsletter-title" id="gl-nl-{{variant}}">New posts, in your inbox</h2>
            <p class="gl-newsletter-sub">Releases and write-ups from Gully Labs. No noise; unsubscribe any time.</p>
        </div>
        <form class="gl-newsletter-form" data-members-form="subscribe">
            <label class="gl-sr" for="gl-nl-email-{{variant}}">Email address</label>
            <input class="gl-input" id="gl-nl-email-{{variant}}" type="email" name="email" autocomplete="email" placeholder="you@example.com" required data-members-email>
            <button class="gl-btn gl-btn--gold" type="submit"><span class="gl-nl-default">Subscribe</span><span class="gl-nl-loading">Sending…</span></button>
            <p class="gl-newsletter-msg gl-nl-success">Check your inbox to confirm.</p>
            <p class="gl-newsletter-msg gl-nl-error">That did not work. Check the address and try again.</p>
        </form>
    </div>
</section>
