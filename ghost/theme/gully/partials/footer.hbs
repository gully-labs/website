{{!-- The footer: the kit's full logo (flask + wordmark + tagline), the tagline as text, "Start a project", the four
      columns (Products, App and API, Company, Social), the legal line and the kit's "Powered by Gully Labs" badge.
      No Ghost credit, by design. --}}
<footer class="gl-footer">
    <div class="gl-footer-main gl-page">
        <div class="gl-footer-brand">
            <a class="gl-footer-logo" href="https://gullylabs.xyz" target="_blank" rel="noopener noreferrer">
                {{> "brand/logo"}}<span class="gl-sr"> Gully Labs home (opens in a new tab)</span>
            </a>
            <p class="gl-footer-tagline">You Think It, We Ship It.</p>
            <p class="gl-footer-about">A blockchain development company building and releasing Web3 projects. This is our blog: releases and write-ups.</p>
            <a class="gl-btn gl-btn--primary" href="https://gullylabs.xyz/#services" target="_blank" rel="noopener noreferrer">
                {{> "icons/rocket"}}<span>Start a project</span>{{> "btn-arrow" ext=true}}
            </a>
        </div>
        <div class="gl-footer-cols">
            <nav class="gl-footer-col" aria-labelledby="gl-foot-products">
                <h2 class="gl-footer-head" id="gl-foot-products">Products</h2>
                <ul class="gl-footer-list" role="list">
                    {{> "links/products" style="footer"}}
                    {{> "nav-entry" style="footer" ext=true href="https://gullylabs.xyz/pricing" icon="tag" label="Pricing"}}
                </ul>
            </nav>
            <nav class="gl-footer-col" aria-labelledby="gl-foot-app">
                <h2 class="gl-footer-head" id="gl-foot-app">App &amp; API</h2>
                <ul class="gl-footer-list" role="list">{{> "links/app" style="footer"}}</ul>
            </nav>
            <nav class="gl-footer-col" aria-labelledby="gl-foot-company">
                <h2 class="gl-footer-head" id="gl-foot-company">Company</h2>
                <ul class="gl-footer-list" role="list">{{> "links/company" style="footer"}}</ul>
            </nav>
            <nav class="gl-footer-col" aria-labelledby="gl-foot-social">
                <h2 class="gl-footer-head" id="gl-foot-social">Social</h2>
                <ul class="gl-footer-list" role="list">{{> "links/social" style="footer"}}</ul>
            </nav>
        </div>
    </div>
    <div class="gl-footer-legal gl-page">
        <div class="gl-footer-legal-left">
            {{> "brand/badge"}}
            <span class="gl-footer-copy">© {{date format="YYYY"}} Gully Labs</span>
            <nav class="gl-footer-secondary" aria-label="More from the blog" data-gl-ext-scan>{{navigation type="secondary"}}</nav>
        </div>
        <p class="gl-footer-disclaimer">Information only, not investment advice. Prices and gaps are read live and can be late or wrong; stock tokens are issued by third parties whose own terms apply, and may not be available where you live.</p>
    </div>
</footer>
