{{!-- Shown while the blog has no published posts: the one empty state (section 01; home.hbs follows it with the
      tracker strip as 02). The kit's "building" mascot (562x896, shown at half size, never cropped) on the right. --}}
<section class="gl-empty gl-page" aria-labelledby="gl-empty-title">
    <div class="gl-empty-copy">
        <p class="gl-kicker"><span class="gl-kicker-num">01</span><span>Gully Labs Blog</span></p>
        <h1 class="gl-empty-title" id="gl-empty-title">First posts coming soon</h1>
        <p class="gl-empty-sub">Releases, build notes and write-ups from the team behind the Stock tracker, Holder Map, Gully AI, Gully Analytics, Gully Pay, Gully Chain and Chain Kit. While we write them, the products are live:</p>
        <div class="gl-empty-actions">
            <a class="gl-btn gl-btn--primary" href="https://app.gullylabs.xyz" target="_blank" rel="noopener noreferrer">{{> "icons/rocket"}}<span>Open the app</span>{{> "btn-arrow" ext=true}}</a>
            <a class="gl-btn gl-btn--secondary" href="https://docs.gullylabs.xyz" target="_blank" rel="noopener noreferrer">{{> "icons/book-open"}}<span>Read the docs</span>{{> "btn-arrow" ext=true}}</a>
        </div>
    </div>
    <div class="gl-mascot-box">
        <img class="gl-mascot" src="{{asset "brand/mascots/mascot-1-building-feathered.png"}}" width="281" height="448" alt="" fetchpriority="high" decoding="async">
    </div>
</section>
