{{!-- Shown while the blog has no published posts: the one empty state (section 01; home.hbs follows it with the
      tracker strip as 02). The animated banner is seeded like a post banner, so it is always the same picture. --}}
<section class="gl-empty gl-page" aria-labelledby="gl-empty-title">
    {{> "banner" variant="hero" seed="gully-labs-blog" label="First posts coming soon" tag="releases" tagname="Gully Labs Blog" eager=true}}
    <div class="gl-empty-copy">
        <p class="gl-kicker"><span class="gl-kicker-num">01</span><span>Gully Labs Blog</span></p>
        <h1 class="gl-empty-title" id="gl-empty-title">First posts coming soon</h1>
        <p class="gl-empty-sub">Releases, build notes and write-ups from the team behind the Stock tracker, Holder Map, Gully AI, Gully Analytics, Gully Pay and Chain Kit. While we write them, the products are live:</p>
        <div class="gl-empty-actions">
            <a class="gl-btn gl-btn--gold" href="https://gullylabs.xyz/tracker" target="_blank" rel="noopener noreferrer">{{> "icons/activity"}}<span>Open the Stock tracker</span>{{> "ext-mark"}}</a>
            <a class="gl-btn gl-btn--outline" href="https://docs.gullylabs.xyz" target="_blank" rel="noopener noreferrer">{{> "icons/book-open"}}<span>Read the docs</span>{{> "ext-mark"}}</a>
        </div>
    </div>
</section>
