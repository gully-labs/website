{{!-- Shown while the blog has no published posts: the one empty state (section 01; home.hbs follows it with the
      tracker strip as 02). The kit's owl (laptop pose, the website's derived WebP, at its own ratio) on the right. --}}
<section class="gl-empty gl-page" aria-labelledby="gl-empty-title">
    <div class="gl-empty-copy">
        <p class="gl-kicker"><span class="gl-kicker-num">01</span><span>Gully Labs Blog</span></p>
        <h1 class="gl-empty-title" id="gl-empty-title">First posts coming soon</h1>
        <p class="gl-empty-sub">Releases, build notes and write-ups from the Gully Labs team. While we write them, the products are live:</p>
        <div class="gl-empty-actions">
            <a class="gk-btn gk-btn--primary" href="https://app.gullylabs.xyz" target="_blank" rel="noopener noreferrer">{{> "icons/rocket"}}<span>Open the app</span>{{> "btn-arrow" ext=true}}</a>
            <a class="gk-btn gk-btn--secondary" href="https://docs.gullylabs.xyz" target="_blank" rel="noopener noreferrer">{{> "icons/book-open"}}<span>Read the docs</span>{{> "btn-arrow" ext=true}}</a>
        </div>
    </div>
    <div class="gl-mascot-box">
        <img class="gl-mascot" src="{{asset "brand/mascots/owl-laptop-800.webp"}}" srcset="{{asset "brand/mascots/owl-laptop-400.webp"}} 172w, {{asset "brand/mascots/owl-laptop-800.webp"}} 343w" sizes="192px" width="192" height="448" alt="" fetchpriority="high" decoding="async">
    </div>
</section>
