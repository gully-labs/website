{{!-- The mobile menu: a full-height sheet with the header's groups as accordions (as on the site).
      Outside <header> on purpose: the header's backdrop blur would trap a fixed child. --}}
<div class="gl-sheet" id="gl-sheet" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
    <div class="gl-sheet-top gl-page">
        <div class="gl-brand">
            <a class="gl-wordmark" href="https://gullylabs.xyz" target="_blank" rel="noopener noreferrer">
                <span class="gl-wordmark-gully">GULLY</span><span class="gl-wordmark-labs">LABS</span><span class="gl-sr"> home (opens in a new tab)</span>
            </a>
            <span class="gl-brand-sep" aria-hidden="true">/</span>
            <a class="gl-brand-blog" href="{{@site.url}}">Blog</a>
        </div>
        <button type="button" class="gl-btn gl-btn--outline" data-gl-sheet-close>{{> "icons/x"}}<span>Close</span></button>
    </div>

    <nav class="gl-sheet-body gl-page" aria-label="Mobile">
        <div class="gl-acc">
            <h2 class="gl-acc-head">
                <button type="button" class="gl-acc-trigger" aria-expanded="false" aria-controls="gl-acc-blog">
                    <span class="gl-acc-title">{{> "icons/newspaper"}}Blog</span>{{> "icons/chevron-down"}}
                </button>
            </h2>
            <div class="gl-acc-panel" id="gl-acc-blog" role="region" aria-label="Blog" hidden>
                <div class="gl-sheet-blognav" data-gl-ext-scan>{{navigation}}</div>
                <ul class="gl-menu-list" role="list">
                    <li class="gl-entry gl-entry--menu">
                        <button type="button" class="gl-entry-link" data-ghost-search>
                            <span class="gl-entry-icon">{{> "icons/search"}}</span>
                            <span class="gl-entry-text"><span class="gl-entry-label">Search the blog</span></span>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
        <div class="gl-acc">
            <h2 class="gl-acc-head">
                <button type="button" class="gl-acc-trigger" aria-expanded="false" aria-controls="gl-acc-products">
                    <span class="gl-acc-title">{{> "icons/boxes"}}Products</span>{{> "icons/chevron-down"}}
                </button>
            </h2>
            <div class="gl-acc-panel" id="gl-acc-products" role="region" aria-label="Products" hidden>
                <ul class="gl-menu-list" role="list">{{> "links/products" style="menu"}}</ul>
            </div>
        </div>
        <div class="gl-acc">
            <h2 class="gl-acc-head">
                <button type="button" class="gl-acc-trigger" aria-expanded="false" aria-controls="gl-acc-developers">
                    <span class="gl-acc-title">{{> "icons/code"}}App &amp; API</span>{{> "icons/chevron-down"}}
                </button>
            </h2>
            <div class="gl-acc-panel" id="gl-acc-developers" role="region" aria-label="App and API" hidden>
                <ul class="gl-menu-list" role="list">{{> "links/developers" style="menu"}}</ul>
            </div>
        </div>
        <a class="gl-acc-link" href="https://gullylabs.xyz/#projects" target="_blank" rel="noopener noreferrer"><span class="gl-acc-title">{{> "icons/flask-conical"}}Projects</span>{{> "ext-mark"}}</a>
        <a class="gl-acc-link" href="https://gullylabs.xyz/pricing" target="_blank" rel="noopener noreferrer"><span class="gl-acc-title">{{> "icons/tag"}}Pricing</span>{{> "ext-mark"}}</a>

        <div class="gl-sheet-launch">
            <p class="gl-kicker">Launch app</p>
            <a class="gl-btn gl-btn--gold gl-btn--block" href="https://gullylabs.xyz/tracker" target="_blank" rel="noopener noreferrer">{{> "icons/activity"}}<span>Stock tracker</span>{{> "ext-mark"}}</a>
        </div>
        <ul class="gl-sheet-social" role="list">
            <li><a class="gl-iconbtn gl-iconbtn--box" href="https://x.com/Gully_Labs" target="_blank" rel="noopener noreferrer">{{> "icons/brand-x"}}<span class="gl-sr">X (opens in a new tab)</span></a></li>
            <li><a class="gl-iconbtn gl-iconbtn--box" href="https://github.com/gully-labs" target="_blank" rel="noopener noreferrer">{{> "icons/brand-github"}}<span class="gl-sr">GitHub (opens in a new tab)</span></a></li>
            <li><a class="gl-iconbtn gl-iconbtn--box" href="https://t.me/GullyLabsBot" target="_blank" rel="noopener noreferrer">{{> "icons/brand-telegram"}}<span class="gl-sr">Telegram (opens in a new tab)</span></a></li>
        </ul>
    </nav>
</div>
