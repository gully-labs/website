{{!--
    The header, one line at every width from 1024 to 1920: the brand kit's compact lockup (icon + horizontal wordmark,
    to gullylabs.xyz, new tab) and "Blog" (this blog), the Products and App & API menus, Projects and Pricing, and the
    signature "Launch app" button, plus (wider screens) the live pill and a ghost "Docs" pill, as on gullylabs.xyz. Below it, a hairline bar with the blog's own sections ({{navigation}} from Ghost
    admin, each with a Lucide icon) and search. No sign-in, subscribe or account buttons: the blog has no email opt-in.

    Menus are disclosure buttons (aria-expanded + aria-controls, not role="menu"): click, Enter or
    Space opens; Escape closes and returns focus; arrow keys move between items (assets/js/gully.js).
    Under 1024 px the Menu button opens the full-height sheet (partials/mobile-sheet.hbs).
--}}
<header class="gl-header" id="gl-header">
    <div class="gl-bar gl-page">
        <div class="gl-brand">
            <a class="gl-wordmark" href="https://gullylabs.xyz" target="_blank" rel="noopener noreferrer">
                {{> "brand/lockup"}}<span class="gl-sr">Gully Labs home (opens in a new tab)</span>
            </a>
            <span class="gl-brand-sep" aria-hidden="true">/</span>
            <a class="gl-brand-blog" href="{{@site.url}}">Blog</a>
        </div>

        <nav class="gl-nav" aria-label="Gully Labs">
            <ul class="gl-nav-list" data-gl-menubar>
                <li class="gl-nav-item">
                    <button type="button" class="gl-nav-trigger" aria-expanded="false" aria-controls="gl-menu-products">
                        {{> "icons/boxes"}}<span>Products</span>{{> "icons/chevron-down"}}
                    </button>
                    <div class="gl-menu gl-menu--wide" id="gl-menu-products" hidden>
                        <ul class="gl-menu-list">{{> "links/products" style="menu"}}</ul>
                    </div>
                </li>
                <li class="gl-nav-item">
                    <button type="button" class="gl-nav-trigger" aria-expanded="false" aria-controls="gl-menu-app">
                        {{> "icons/code"}}<span>App &amp; API</span>{{> "icons/chevron-down"}}
                    </button>
                    <div class="gl-menu" id="gl-menu-app" hidden>
                        <ul class="gl-menu-list">{{> "links/app" style="menu"}}</ul>
                    </div>
                </li>
                <li class="gl-nav-item">
                    <a class="gl-nav-link" href="https://gullylabs.xyz/#projects" target="_blank" rel="noopener noreferrer">
                        {{> "icons/flask-conical"}}<span>Projects</span>{{> "ext-mark"}}
                    </a>
                </li>
                <li class="gl-nav-item">
                    <a class="gl-nav-link" href="https://gullylabs.xyz/pricing" target="_blank" rel="noopener noreferrer">
                        {{> "icons/tag"}}<span>Pricing</span>{{> "ext-mark"}}
                    </a>
                </li>
            </ul>
        </nav>

        <div class="gl-actions">
            {{!-- Live pill, as on gullylabs.xyz: the time of the last stats read (set by the ticker in assets/js/gully.js).
                  Static dot: the ticker strip below is the page's one continuously animated element. 1280 px and up. --}}
            <a class="gl-livepill" href="https://gullylabs.xyz" target="_blank" rel="noopener noreferrer" data-gl-livepill>
                <span class="gl-livepill-dot" aria-hidden="true"></span><span>Live</span><span class="gl-livepill-time" data-gl-live-time></span><span class="gl-sr"> stats on gullylabs.xyz (opens in a new tab)</span>
            </a>
            <a class="gl-btn gl-btn--ghost gl-docs" href="https://docs.gullylabs.xyz" target="_blank" rel="noopener noreferrer">
                {{> "icons/book-open"}}<span>Docs</span><span class="gl-sr"> (opens in a new tab)</span>
            </a>
            <a class="gl-btn gl-btn--primary gl-launch" href="https://app.gullylabs.xyz" target="_blank" rel="noopener noreferrer">
                {{> "icons/rocket"}}<span>Launch app</span>{{> "btn-arrow" ext=true}}
            </a>
            <button type="button" class="gl-btn gl-btn--ghost gl-menu-button" aria-expanded="false" aria-haspopup="dialog" aria-controls="gl-sheet" data-gl-sheet-open>
                {{> "icons/menu"}}<span>Menu</span>
            </button>
        </div>
    </div>

    <div class="gl-subbar">
        <div class="gl-subbar-inner gl-page">
            <nav class="gl-blognav" aria-label="Blog sections" data-gl-ext-scan>
                {{navigation}}
            </nav>
            <div class="gl-subbar-actions">
                <button type="button" class="gl-iconbtn" data-gl-copy="{{@site.url}}/rss/" data-gl-copy-msg="RSS feed link copied: add it to your reader" aria-label="Copy the RSS feed link to follow the blog">{{> "icons/rss"}}<span class="gl-subbar-label">Follow</span></button>
                <button type="button" class="gl-iconbtn" data-ghost-search aria-label="Search the blog">{{> "icons/search"}}<span class="gl-subbar-label">Search</span></button>
            </div>
        </div>
    </div>

    {{#is "post"}}<div class="gl-progress" aria-hidden="true"><span class="gl-progress-bar"></span></div>{{/is}}
</header>
