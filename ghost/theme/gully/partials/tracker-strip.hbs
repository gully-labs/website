{{!-- "From Gully Labs": links to what is live on gullylabs.xyz. No figures are shown here on
      purpose: live prices and gaps belong on the site, where they are read live. Param: num (the section number). --}}
<section class="gl-section gl-page gl-strip" aria-labelledby="gl-strip-title">
    {{> "section-head" num=num kicker="From Gully Labs" title="Live on gullylabs.xyz" id="gl-strip-title"}}
    <ul class="gl-strip-list" role="list">
        <li>
            <a class="gl-strip-item" href="https://gullylabs.xyz/products" target="_blank" rel="noopener noreferrer">
                {{> "banner" variant="spark" seed="strip-products" label="Products" tag="release"}}
                <span class="gl-strip-text">
                    <span class="gl-strip-label">{{> "icons/boxes"}}All products{{> "ext-mark"}}</span>
                    <span class="gl-strip-desc">Each with its own page and live charts</span>
                </span>
            </a>
        </li>
        <li>
            <a class="gl-strip-item" href="https://gullylabs.xyz/tracker" target="_blank" rel="noopener noreferrer">
                {{> "banner" variant="spark" seed="strip-tracker" label="Stock tracker" tag="tracker"}}
                <span class="gl-strip-text">
                    <span class="gl-strip-label">{{> "icons/activity"}}Stock tracker{{> "ext-mark"}}</span>
                    <span class="gl-strip-desc">Every stock token against its fair price, live</span>
                </span>
            </a>
        </li>
        <li>
            <a class="gl-strip-item" href="https://docs.gullylabs.xyz/api" target="_blank" rel="noopener noreferrer">
                {{> "banner" variant="spark" seed="strip-api" label="API" tag="api"}}
                <span class="gl-strip-text">
                    <span class="gl-strip-label">{{> "icons/file-json"}}Free REST API{{> "ext-mark"}}</span>
                    <span class="gl-strip-desc">The same data, for your own tools</span>
                </span>
            </a>
        </li>
        <li>
            <a class="gl-strip-item" href="https://gullylabs.xyz/widget" target="_blank" rel="noopener noreferrer">
                {{> "banner" variant="spark" seed="strip-widget" label="Widget" tag="release"}}
                <span class="gl-strip-text">
                    <span class="gl-strip-label">{{> "icons/puzzle"}}Price widget{{> "ext-mark"}}</span>
                    <span class="gl-strip-desc">One script tag, live prices on your page</span>
                </span>
            </a>
        </li>
    </ul>
</section>
