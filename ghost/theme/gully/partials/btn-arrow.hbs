{{!-- The signature button's trailing arrow (slides right on hover). ext=true: an up-right arrow and the hidden
      "(opens in a new tab)" text for links to other hosts. --}}
{{#if ext}}<span class="gk-btn-arrow">{{> "icons/arrow-up-right"}}</span><span class="gl-sr"> (opens in a new tab)</span>{{else}}<span class="gk-btn-arrow">{{> "icons/arrow-right"}}</span>{{/if}}
