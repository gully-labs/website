<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{meta_title}}</title>
    <meta name="theme-color" content="#0b0e13">
    {{> "fonts"}}
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
</head>
<body class="error-template">
    {{!-- Server errors (5xx and the rest) render without the default layout, so Ghost can show this
          page even when parts of the site fail. Plain links only, no scripts. --}}
    <div class="gl-viewport">
        <header class="gl-header">
            <div class="gl-bar gl-page">
                <div class="gl-brand">
                    <a class="gl-wordmark" href="https://gullylabs.xyz" target="_blank" rel="noopener noreferrer">
                        <span class="gl-wordmark-gully">GULLY</span><span class="gl-wordmark-labs">LABS</span><span class="gl-sr"> home (opens in a new tab)</span>
                    </a>
                    <span class="gl-brand-sep" aria-hidden="true">/</span>
                    <a class="gl-brand-blog" href="{{@site.url}}">Blog</a>
                </div>
            </div>
        </header>
        <main id="gl-main" class="gl-main gl-error">
            <section class="gl-error-box gl-error-box--plain gl-page">
                <div class="gl-error-copy">
                    <p class="gl-kicker"><span class="gl-kicker-num">{{statusCode}}</span><span>Something went wrong</span></p>
                    <h1 class="gl-error-title">{{#if message}}{{message}}{{else}}We could not load this page{{/if}}</h1>
                    <p class="gl-error-sub">Please try again in a moment. If it keeps happening, tell us on X or Telegram.</p>
                    <div class="gl-empty-actions">
                        <a class="gl-btn gl-btn--gold" href="{{@site.url}}">{{> "icons/newspaper"}}<span>Blog home</span></a>
                        <a class="gl-btn gl-btn--outline" href="https://x.com/Gully_Labs" target="_blank" rel="noopener noreferrer">{{> "icons/brand-x"}}<span>@Gully_Labs</span>{{> "ext-mark"}}</a>
                        <a class="gl-btn gl-btn--outline" href="https://t.me/GullyLabsBot" target="_blank" rel="noopener noreferrer">{{> "icons/brand-telegram"}}<span>Telegram</span>{{> "ext-mark"}}</a>
                    </div>
                    {{#if errorDetails}}
                        <details class="gl-error-details">
                            <summary>Technical details</summary>
                            <ul>
                                {{#foreach errorDetails}}
                                    <li><code>{{{rule}}}</code>{{#foreach failures}} <span>{{ref}}: {{message}}</span>{{/foreach}}</li>
                                {{/foreach}}
                            </ul>
                        </details>
                    {{/if}}
                </div>
            </section>
        </main>
        <footer class="gl-footer">
            <div class="gl-footer-legal gl-page">
                <span class="gl-footer-copy">© GULLY LABS</span>
                <p class="gl-footer-disclaimer">Information only, not investment advice.</p>
            </div>
        </footer>
    </div>
</body>
</html>
