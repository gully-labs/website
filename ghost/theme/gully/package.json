{
    "name": "gully",
    "description": "The Gully Labs blog theme, in the 2026 Gully Labs brand kit. Built on Ghost's Source theme (MIT, Ghost Foundation).",
    "demo": "https://blog.gullylabs.xyz",
    "version": "2.0.0",
    "engines": {
        "ghost": ">=6.0.0"
    },
    "license": "MIT",
    "author": {
        "name": "Gully Labs",
        "email": "peddlepadteam@gmail.com",
        "url": "https://gullylabs.xyz"
    },
    "keywords": [
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/gully-labs"
    },
    "config": {
        "posts_per_page": 6,
        "image_sizes": {
            "xs": {
                "width": 160
            },
            "s": {
                "width": 320
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 960
            },
            "xl": {
                "width": 1200
            },
            "xxl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
            "animated_banners": {
                "type": "boolean",
                "default": false,
                "description": "Animate post banners (off: the stats ticker is the one live animation)"
            },
            "show_tracker_strip": {
                "type": "boolean",
                "default": true,
                "group": "homepage",
                "description": "Show the 'From the Stock tracker' links to gullylabs.xyz on the home page"
            },
            "generated_post_share_images": {
                "type": "boolean",
                "default": false,
                "group": "post",
                "description": "Posts without a feature image share the generated gullylabs.xyz/og/blog still, not the kit OG image"
            }
        }
    }
}
