{{!< default}}
<main id="gl-main" class="gl-main gl-error" tabindex="-1">
    <section class="gl-error-box gl-page">
        <div class="gl-error-copy">
            <p class="gl-kicker"><span class="gl-kicker-num">404</span><span>Page not found</span></p>
            <h1 class="gl-error-title">This page is off the chain</h1>
            <p class="gl-error-sub">The link may be old, or the post may have moved. Try the latest posts, or head to the site.</p>
            <div class="gl-empty-actions">
                <a class="gl-btn gl-btn--primary" href="{{@site.url}}">{{> "icons/newspaper"}}<span>Latest posts</span>{{> "btn-arrow"}}</a>
                <a class="gl-btn gl-btn--ghost" href="https://gullylabs.xyz" target="_blank" rel="noopener noreferrer">{{> "icons/house"}}<span>gullylabs.xyz</span>{{> "btn-arrow" ext=true}}</a>
            </div>
        </div>
        <div class="gl-mascot-box">
            {{!-- The kit's "planning" mascot (562x896, shown at half size, never cropped). --}}
            <img class="gl-mascot" src="{{asset "brand/mascots/mascot-2-planning-feathered.png"}}" width="281" height="448" alt="" decoding="async">
        </div>
    </section>
    {{#get "posts" limit="3" include="tags,authors" as |latest|}}
        {{#if latest}}
            <section class="gl-section gl-page" aria-labelledby="gl-404-latest">
                {{> "section-head" num="01" kicker="Latest" title="Recent posts" id="gl-404-latest"}}
                <div class="gl-grid">{{#foreach latest}}{{> "post-card"}}{{/foreach}}</div>
            </section>
        {{/if}}
    {{/get}}
</main>
