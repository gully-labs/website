# Gully Hyperlane agents: copy to .env (chmod 600). Never commit .env. Every value here is a placeholder.
# Variable names are the env form of the agent arguments (configuration reference): the path of the config key,
# upper-cased, joined with underscores, prefixed HYP_.

# Which chain our validator signs for, and which pair the relayer serves (compose.yaml defaults shown).
HYPERLANE_ORIGIN_CHAIN=gullydevnet
HYPERLANE_RELAY_CHAINS=gullydevnet,arbitrumsepolia

# Validator signing key (--validator.key). Signs Mailbox checkpoints; never needs funds. Its address is the one
# in the L3's multisig ISM config. Generate fresh: `cast wallet new`.
HYP_VALIDATOR_KEY=0x__validator_signing_key__

# Validator announce transaction signer (--chains.gullydevnet.signer.key). Needs a little gas on the ORIGIN chain
# for the one-time ValidatorAnnounce transaction. On the light devnet the public dev account can fund it.
HYP_CHAINS_GULLYDEVNET_SIGNER_KEY=0x__validator_tx_signer_key__

# Relayer signing key (--defaultSigner.key). Pays Mailbox.process() on EVERY destination chain in
# HYPERLANE_RELAY_CHAINS, so it must hold ETH on the devnet AND on Arbitrum Sepolia (faucet). One key per relayer.
HYP_DEFAULTSIGNER_KEY=0x__relayer_key__

# Testing only: relay every message whether or not interchain gas was paid. Production uses the IGP policies
# (minimum / onChainFeeQuoting) so the relayer is reimbursed.
HYP_GASPAYMENTENFORCEMENT=[{"type":"none"}]

# Optional: our own RPC for the public chain instead of the template's list (comma-separated). The validator docs
# require your own RPC, not a public one, in production.
# HYP_CHAINS_ARBITRUMSEPOLIA_CUSTOMRPCURLS=https://...

# Metrics ports on 127.0.0.1 (preflight checks they are free).
GULLY_HYPERLANE_VALIDATOR_METRICS_PORT=9090
GULLY_HYPERLANE_RELAYER_METRICS_PORT=9091
